{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "iask",
  "main": "worker.js",
  "account_id": "b425871b9261921b21e80757e6f94d92",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "secrets": {"required": ["COMMENTNEST_GITHUB_APP_PRIVATE_KEY", "COMMENTNEST_GITHUB_APP_CLIENT_SECRET"]},
  "vars": {
    "COMMENTNEST_REPOSITORY": "jsw-teams/web",
    "COMMENTNEST_SITE_ORIGIN": "https://iask.js.gripe",
    "COMMENTNEST_WEBSITE_ORIGIN": "https://js.gripe",
    "COMMENTNEST_ADDITIONAL_WEBSITES": "[{\"origin\":\"https://connect.js.gripe\",\"prefix\":\"connect:\"}]",
    "COMMENTNEST_GITHUB_APP_ID": "5165740",
    "COMMENTNEST_GITHUB_APP_CLIENT_ID": "Iv23liJRDmvDUn1uZeQ5"
  },
  "assets": {
    "directory": "../../dist",
    "binding": "COMMENTNEST_ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api", "/frame", "/auth", "/api/comments", "/api/comments/session", "/api/comments/login", "/api/comments/logout", "/api/comments/callback",
      "/api/comments/media/*", "/api/comments/avatar/*", "/commentnest/embed", "/commentnest/auth-complete",
      "!/", "!/.env*", "!/.git/*", "!/.well-known/*", "!/wp-*", "!/commentnest/*.*"
    ]
  },
  "durable_objects": {
    "bindings": [{"name": "COMMENTNEST_THREADS", "class_name": "CommentCoordinator"}]
  },
  "migrations": [{"tag": "comments", "new_sqlite_classes": ["CommentCoordinator"]}]
}
