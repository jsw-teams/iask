{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/service.js": {"maxDuration": 60, "includeFiles": "dist/commentnest/**"}
  },
  "rewrites": [
    {"source":"/auth","destination":"/api/service"},
    {"source":"/api","destination":"/api/service"},
    {"source":"/frame","destination":"/api/service"},
    {"source": "/api/comments", "destination": "/api/service"},
    {"source": "/api/comments/session", "destination": "/api/service"},
    {"source": "/api/comments/login", "destination": "/api/service"},
    {"source": "/api/comments/logout", "destination": "/api/service"},
    {"source": "/api/comments/callback", "destination": "/api/service"},
    {"source": "/api/comments/media/:path*", "destination": "/api/service"},
    {"source": "/api/comments/avatar/:id", "destination": "/api/service"},
    {"source": "/commentnest/embed", "destination": "/api/service"},
    {"source": "/commentnest/auth-complete", "destination": "/api/service"}
  ],
  "headers": [
    {"source":"/commentnest/:path*","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cross-Origin-Resource-Policy","value":"cross-origin"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Cache-Control","value":"public, max-age=300, must-revalidate"}]},
    {"source":"/commentnest/:asset(.*\\.[a-f0-9]{16}\\..*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/commentnest/widget.js","headers":[{"key":"Cache-Control","value":"public, max-age=60, must-revalidate"}]},
    {"source":"/commentnest/embed","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/commentnest/auth-complete","headers":[{"key":"Cache-Control","value":"no-store"}]}
  ]
}
