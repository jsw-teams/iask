  "public": true,
  "request_oauth_on_install": false,
  "setup_on_update": true,
  "hook_attributes": {
    "active": false
  },
  "default_permissions": {
    "metadata": "read",
    "issues": "write",
    "contents": "write"
  },
  "default_events": []
}
