{
  "name": "RepoRelay JS.GRIPE",
  "url": "https://github.com/jsw-teams/RepoRelay",
  "redirect_url": "https://js.gripe/reporelay/",
  "callback_urls": [
    "https://js.gripe/api/comments/callback"
