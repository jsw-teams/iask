{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iask",
  "main": "backend/cloudflare/worker.js",
  "compatibility_date": "2026-10-03",
  "vars": {
    "COMMENTNEST_SITE_ORIGIN": "https://comments.example.com",
    "COMMENTNEST_WEBSITE_ORIGIN": "https://www.example.com",
    "COMMENTNEST_REPOSITORY": "owner/comments",
    "COMMENTNEST_GITHUB_APP_ID": "",
    "COMMENTNEST_GITHUB_APP_CLIENT_ID": ""
  },
  "assets": {
    "directory": "./dist",
    "binding": "COMMENTNEST_ASSETS",
    "run_worker_first": [
      "/api/comments",
      "/api/comments/*",
      "/commentnest/embed",
      "/commentnest/auth-complete"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMENTNEST_THREADS",
        "class_name": "CommentCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "comments",
      "new_sqlite_classes": [
        "CommentCoordinator"
      ]
    }
  ]
}
