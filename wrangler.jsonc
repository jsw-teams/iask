{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iask",
  "main": "backend/cloudflare/worker.js",
  "compatibility_date": "2026-10-03",
  "vars": {
    "COMMENTNEST_SITE_ORIGIN": "https://comments.example.com",
    "COMMENTNEST_WEBSITE_ORIGIN": "https://www.example.com",
    "COMMENTNEST_REPOSITORY": "owner/comments",
    "COMMENTNEST_GITHUB_APP_ID": "",
    "COMMENTNEST_GITHUB_APP_CLIENT_ID": ""
  },
  "assets": {
    "directory": "./dist",
    "binding": "COMMENTNEST_ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/frame",
      "/auth",
      "/api/comments",
      "/api/comments/session",
      "/api/comments/login",
      "/api/comments/logout",
      "/api/comments/callback",
      "/api/comments/media/*",
      "/api/comments/avatar/*",
      "/commentnest/embed",
      "/commentnest/auth-complete",
      "!/",
      "!/.env*",
      "!/.git/*",
      "!/.well-known/*",
      "!/wp-*",
      "!/commentnest/*.*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMENTNEST_THREADS",
        "class_name": "CommentCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "comments",
      "new_sqlite_classes": [
        "CommentCoordinator"
      ]
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
